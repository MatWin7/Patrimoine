# Copier en .env (ignoré par git) puis compléter si besoin.
# Durée de validité du cache des prix, en minutes.
PRICE_TTL_MINUTES=5
# Clé CoinGecko optionnelle (offre gratuite « demo »). Laisser vide sinon.
COINGECKO_API_KEY=
# Dossier des données (D-119). Vide : dossier par défaut du système (~/.local/share/patrimoine
# sous Linux et WSL). Mieux : `uv run python -m app.datadir --choisir DOSSIER`, qui copie les
# données et garde le choix hors du code. Jamais un dossier synchronisé (OneDrive...).
PATRIMOINE_DATA_DIR=
# Base SQLite unique (défaut : data/patrimoine.db, ou un profil). data/demo.db pour déboguer ;
# définie, elle désactive les profils (D-098).
PATRIMOINE_DB=
# Sauvegardes automatiques récentes gardées (une par jour), en plus d'une par mois sur 12 mois
# et d'une par an (D-114).
BACKUP_KEEP=14
# Dossier hors de WSL où recopier chaque jour les sauvegardes (D-114), de préférence sur un autre
# disque que C: (ex. /mnt/d/Patrimoine-sauvegardes). Jamais dans OneDrive. Vide : pas de copie.
BACKUP_COPY_DIR=
# Profils (D-098) : verrouillage après ce nombre de minutes sans activité.
PROFILE_LOCK_MINUTES=30
